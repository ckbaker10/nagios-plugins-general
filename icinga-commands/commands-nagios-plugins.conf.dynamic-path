object CheckCommand "check_swap" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_swap" ]

  arguments = {
    "--warning" = {
      value = "$check_swap_warning$"
      description = "Exit with WARNING status if less than INTEGER bytes of swap space are free"
    }
    "--critical" = {
      value = "$check_swap_critical$"
      description = "Exit with CRITICAL status if less than INTEGER bytes of swap space are free"
    }
    "--allswaps" = {
      set_if = "$check_swap_allswaps$"
      description = "Conduct comparisons for all swap partitions, one by one"
    }
    "--no-swap" = {
      value = "$check_swap_no_swap$"
      description = "Resulting state when there is no swap regardless of thresholds. Default: CRITICAL"
    }
    "--verbose" = {
      set_if = "$check_swap_verbose$"
      description = "Show details for command-line debugging (Nagios may truncate output)"
    }
  }
}

object CheckCommand "check_tcp" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_tcp" ]

  arguments = {
    "--hostname" = {
      value = "$check_tcp_hostname$"
      description = "Host name, IP Address, or unix socket (must be an absolute path)"
    }
    "--critical" = {
      value = "$check_tcp_critical$"
      description = "Response time to result in critical status (seconds)"
    }
    "--warning" = {
      value = "$check_tcp_warning$"
      description = "Response time to result in warning status (seconds)"
    }
    "--critical-codes" = {
      value = "$check_tcp_critical_codes$"
    }
    "--warning-codes" = {
      value = "$check_tcp_warning_codes$"
    }
    "--timeout" = {
      value = "$check_tcp_timeout$"
      description = "state> Seconds before connection times out (default: 10) Optional \":<timeout state>\" can be a state integer (0,1,2,3) or a state STRING"
    }
    "--protocol" = {
      value = "$check_tcp_protocol$"
    }
    "--port" = {
      value = "$check_tcp_port$"
      description = "Port number (default: none)"
    }
    "--escape" = {
      set_if = "$check_tcp_escape$"
      description = "Can use \\n, \\r, \\t or \\\\ in send or quit string. Must come before send or quit option Default: nothing added to send, \\r\\n added to end of quit"
    }
    "--all" = {
      set_if = "$check_tcp_all$"
      description = "All expect strings need to occur in server response. Default is any"
    }
    "--send" = {
      value = "$check_tcp_send$"
      description = "String to send to the server"
    }
    "--expect" = {
      value = "$check_tcp_expect$"
      description = "String to expect in server response (may be repeated)"
    }
    "--maxbytes" = {
      value = "$check_tcp_maxbytes$"
      description = "Close connection once more than this number of bytes are received"
    }
    "--quit" = {
      value = "$check_tcp_quit$"
      description = "String to send server to initiate a clean close of the connection"
    }
    "--jail" = {
      set_if = "$check_tcp_jail$"
      description = "Hide output from TCP socket"
    }
    "--delay" = {
      value = "$check_tcp_delay$"
      description = "Seconds to wait between sending string and polling for response"
    }
    "--refuse" = {
      value = "$check_tcp_refuse$"
      description = "Accept TCP refusals with states ok, warn, crit (default: crit)"
    }
    "--mismatch" = {
      value = "$check_tcp_mismatch$"
      description = "Accept expected string mismatches with states ok, warn, crit (default: warn)"
    }
    "--use-ipv4" = {
      set_if = "$check_tcp_use_ipv4$"
      description = "Use IPv4 connection"
    }
    "--use-ipv6" = {
      set_if = "$check_tcp_use_ipv6$"
      description = "Use IPv6 connection"
    }
    "--verbose" = {
      set_if = "$check_tcp_verbose$"
      description = "Show details for command-line debugging (Nagios may truncate output)"
    }
    "--ssl" = {
      set_if = "$check_tcp_ssl$"
      description = "Use SSL for the connection."
    }
    "--certificate" = {
      value = "$check_tcp_certificate$"
      description = "Minimum number of days a certificate has to be valid. 1st is #days for warning, 2nd is critical (if not specified - 0)."
    }
    "--sni" = {
      value = "$check_tcp_sni$"
    }
  }

  vars.check_tcp_hostname = "$address$"
}

