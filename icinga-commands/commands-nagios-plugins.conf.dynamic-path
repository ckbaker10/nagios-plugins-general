object CheckCommand "check_ifoperstatus" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_ifoperstatus" ]

  arguments = {
    "--snmp_version" = {
      value = "$check_ifoperstatus_snmp_version$"
      description = "for SNMP v1 (default) 2 for SNMP v2c SNMP v2c will use get_bulk for less overhead if monitoring with -d"
    }
    "--community" = {
      value = "$check_ifoperstatus_community$"
      description = "read community (defaults to public, used with SNMP v1 and v2c"
    }
    "--seclevel" = {
      value = "$check_ifoperstatus_seclevel$"
      description = "choice of \"noAuthNoPriv\", \"authNoPriv\", or \"authPriv\""
    }
    "--authproto" = {
      value = "$check_ifoperstatus_authproto$"
      description = "Authentication protocol (MD5 or SHA1)"
    }
    "--secname" = {
      value = "$check_ifoperstatus_secname$"
      description = "username for SNMPv3 context"
    }
    "--authpass" = {
      value = "$check_ifoperstatus_authpass$"
      description = "authentication password (cleartext ascii or localized key in hex with 0x prefix generated by using \"snmpkey\" utility auth password and authEngineID"
    }
    "--privpass" = {
      value = "$check_ifoperstatus_privpass$"
      description = "privacy password (cleartext ascii or localized key in hex with 0x prefix generated by using \"snmpkey\" utility privacy password and authEngineID"
    }
    "--privproto" = {
      value = "$check_ifoperstatus_privproto$"
      description = "privacy protocol (DES or AES; default: DES)"
    }
    "--context" = {
      value = "$check_ifoperstatus_context$"
      description = "SNMPv3 context name (default is empty string)"
    }
    "-k" = {
      value = "$check_ifoperstatus_k$"
      description = "IfIndex value"
    }
    "--descr" = {
      value = "$check_ifoperstatus_descr$"
      description = "ifDescr value"
    }
    "--lastchange" = {
      value = "$check_ifoperstatus_lastchange$"
    }
    "--port" = {
      value = "$check_ifoperstatus_port$"
      description = "port (default 161)"
    }
    "--hostname" = {
      value = "$check_ifoperstatus_hostname$"
      description = "Hostname to query - (required)"
    }
    "--ifmib" = {
      set_if = "$check_ifoperstatus_ifmib$"
      description = "Agent supports IFMIB ifXTable. Do not use if you don't know what this is."
    }
    "--name" = {
      value = "$check_ifoperstatus_name$"
      description = "the value should match the returned ifName (Implies the use of -I)"
    }
    "--warn" = {
      value = "$check_ifoperstatus_warn$"
      description = "=i|w|c) ignore|warn|crit if the interface is dormant (default critical)"
    }
    "--admin-down" = {
      value = "$check_ifoperstatus_admin_down$"
      description = "=i|w|c) same for administratively down interfaces (default warning)"
    }
    "--maxmsgsize" = {
      value = "$check_ifoperstatus_maxmsgsize$"
      description = "Max message size - useful only for v1 or v2c"
    }
    "--timeout" = {
      value = "$check_ifoperstatus_timeout$"
      description = "seconds before the plugin times out (default=15)"
    }
    "--type" = {
      value = "$check_ifoperstatus_type$"
      description = "ifType integer value (see http://www.iana.org/assignments/ianaiftype-mib)"
    }
  }

  vars.check_ifoperstatus_hostname = "$address$"
}

object CheckCommand "check_ifstatus" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_ifstatus" ]

  arguments = {
    "--snmp_version" = {
      value = "$check_ifstatus_snmp_version$"
      description = "for SNMP v1 (default) 2 for SNMP v2c SNMP v2c will use get_bulk for less overhead 3 for SNMPv3 (requires -U option) -p (--port) SNMP port (default 161)"
    }
    "--community" = {
      value = "$check_ifstatus_community$"
      description = "read community (defaults to public, used with SNMP v1 and v2c"
    }
    "--exclude_ports_by_description" = {
      value = "$check_ifstatus_exclude_ports_by_description$"
      description = "comma separated list of LocIfDescr values that should be excluded from the report (default is an empty exclusion list). Done using regexp '/^arg/', ex: '-d connect,test' will match with descriptions like 'testing phase' but not 'in testing'."
    }
    "--seclevel" = {
      value = "$check_ifstatus_seclevel$"
      description = "choice of \"noAuthNoPriv\", \"authNoPriv\", or \"authPriv\""
    }
    "--authproto" = {
      value = "$check_ifstatus_authproto$"
      description = "Authentication protocol (MD5 or SHA1)"
    }
    "--secname" = {
      value = "$check_ifstatus_secname$"
      description = "username for SNMPv3 context"
    }
    "--authpass" = {
      value = "$check_ifstatus_authpass$"
      description = "authentication password (cleartext ascii or localized key in hex with 0x prefix generated by using \"snmpkey\" utility auth password and authEngineID"
    }
    "--privpass" = {
      value = "$check_ifstatus_privpass$"
      description = "privacy password (cleartext ascii or localized key in hex with 0x prefix generated by using \"snmpkey\" utility privacy password and authEngineID"
    }
    "--privproto" = {
      value = "$check_ifstatus_privproto$"
      description = "privacy protocol (DES or AES; default: DES)"
    }
    "--context" = {
      value = "$check_ifstatus_context$"
      description = "SNMPv3 context name (default is empty string)"
    }
    "--port" = {
      value = "$check_ifstatus_port$"
    }
    "--hostname" = {
      value = "$check_ifstatus_hostname$"
      description = "Hostname to query - (required)"
    }
    "--ifmib" = {
      set_if = "$check_ifstatus_ifmib$"
      description = "Agent supports IFMIB ifXTable. For Cisco - this will provide the descriptive name. Do not use if you don't know what this is."
    }
    "--exclude" = {
      value = {{
        var v = macro("$check_ifstatus_exclude$")
        if (v == true) { return "--exclude" }
        if (v != false && v != "") { return "--exclude=" + v }
      }}
      skip_key = true
      set_if = {{
        var v = macro("$check_ifstatus_exclude$")
        return v != false && v != "" && v != null
      }}
      description = "comma separated list of ifType values that should be excluded from the report (default for an empty list is PPP(23)."
    }
    "--unused_ports" = {
      value = "$check_ifstatus_unused_ports$"
      description = "comma separated list of ifIndex values that should be excluded from the report (default is an empty exclusion list). See the IANAifType-MIB for a list of interface types."
    }
    "--unused_ports_by_name" = {
      value = "$check_ifstatus_unused_ports_by_name$"
      description = "comma separated list of ifDescr values that should be excluded from the report (default is an empty exclusion list)."
    }
    "--maxmsgsize" = {
      value = "$check_ifstatus_maxmsgsize$"
      description = "Max message size - useful only for v1 or v2c"
    }
    "--timeout" = {
      value = "$check_ifstatus_timeout$"
      description = "seconds before the plugin times out (default=15)"
    }
  }

  vars.check_ifstatus_hostname = "$address$"
}

object CheckCommand "check_ircd" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_ircd" ]

  arguments = {
    "--verbose" = {
      set_if = "$check_ircd_verbose$"
      description = "Print extra debugging information"
    }
    "--timeout" = {
      value = "$check_ircd_timeout$"
    }
    "--warning" = {
      value = "$check_ircd_warning$"
      description = "Number of connected users which generates a warning state (Default: 50)"
    }
    "--critical" = {
      value = "$check_ircd_critical$"
      description = "Number of connected users which generates a critical state (Default: 100)"
    }
    "--port" = {
      value = "$check_ircd_port$"
      description = "Port that the ircd daemon is running on <host> (Default: 6667)"
    }
    "--hostname" = {
      value = "$check_ircd_hostname$"
      description = "Name or IP address of host to check"
    }
  }

  vars.check_ircd_hostname = "$address$"
}

object CheckCommand "check_ldap" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_ldap" ]

  arguments = {
    "--timeout" = {
      value = "$check_ldap_timeout$"
    }
    "--hostname" = {
      value = "$check_ldap_hostname$"
    }
    "--uri" = {
      value = "$check_ldap_uri$"
    }
    "--base" = {
      value = "$check_ldap_base$"
    }
    "--attr" = {
      value = "$check_ldap_attr$"
    }
    "--bind" = {
      value = "$check_ldap_bind$"
    }
    "--pass" = {
      value = "$check_ldap_pass$"
    }
    "--ver2" = {
      set_if = "$check_ldap_ver2$"
    }
    "--ver3" = {
      set_if = "$check_ldap_ver3$"
    }
    "--starttls" = {
      set_if = "$check_ldap_starttls$"
    }
    "--ssl" = {
      set_if = "$check_ldap_ssl$"
    }
    "--age" = {
      value = "$check_ldap_age$"
    }
    "--use-ipv4" = {
      set_if = "$check_ldap_use_ipv4$"
    }
    "--use-ipv6" = {
      set_if = "$check_ldap_use_ipv6$"
    }
    "--port" = {
      value = "$check_ldap_port$"
    }
    "--warn" = {
      value = "$check_ldap_warn$"
    }
    "--crit" = {
      value = "$check_ldap_crit$"
    }
    "--warn-entries" = {
      value = "$check_ldap_warn_entries$"
    }
    "--crit-entries" = {
      value = "$check_ldap_crit_entries$"
    }
    "--verbose" = {
      set_if = "$check_ldap_verbose$"
    }
  }

  vars.check_ldap_hostname = "$address$"
}

