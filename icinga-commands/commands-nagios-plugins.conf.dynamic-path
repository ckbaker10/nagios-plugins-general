object CheckCommand "check_apt" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_apt" ]

  arguments = {
    "--verbose" = {
      set_if = "$check_apt_verbose$"
    }
    "--timeout" = {
      value = "$check_apt_timeout$"
      description = "Seconds before plugin times out (default: 10)"
    }
    "--update" = {
      value = {{
        var v = macro("$check_apt_update$")
        if (v == true) { return "--update" }
        if (v != false && v != "") { return "--update=" + v }
      }}
      skip_key = true
      set_if = {{
        var v = macro("$check_apt_update$")
        return v != false && v != "" && v != null
      }}
      description = "First perform an 'apt-get update'. An optional OPTS parameter overrides the default options. Note: you may also need to adjust the global timeout (with -t) to prevent the plugin from timing out if apt-get upgrade is expected to take longer than the default timeout."
    }
    "--upgrade" = {
      value = {{
        var v = macro("$check_apt_upgrade$")
        if (v == true) { return "--upgrade" }
        if (v != false && v != "") { return "--upgrade=" + v }
      }}
      skip_key = true
      set_if = {{
        var v = macro("$check_apt_upgrade$")
        return v != false && v != "" && v != null
      }}
      description = "[Default] Perform an upgrade. If an optional OPTS argument is provided, apt-get will be run with these command line options instead of the default (-o 'Debug::NoLocking=true' -s -qq). Note that you may be required to have root privileges if you do not use the default options."
    }
    "--no-upgrade" = {
      set_if = "$check_apt_no_upgrade$"
      description = "Do not run the upgrade. Probably not useful (without -u at least)."
    }
    "--dist-upgrade" = {
      value = {{
        var v = macro("$check_apt_dist_upgrade$")
        if (v == true) { return "--dist-upgrade" }
        if (v != false && v != "") { return "--dist-upgrade=" + v }
      }}
      skip_key = true
      set_if = {{
        var v = macro("$check_apt_dist_upgrade$")
        return v != false && v != "" && v != null
      }}
      description = "Perform a dist-upgrade instead of normal upgrade. Like with -U OPTS can be provided to override the default options."
    }
    "--include" = {
      value = "$check_apt_include$"
      description = "Include only packages matching REGEXP. Can be specified multiple times the values will be combined together. Any packages matching this list cause the plugin to return WARNING status. Others will be ignored. Default is to include all packages."
    }
    "--exclude" = {
      value = "$check_apt_exclude$"
      description = "Exclude packages matching REGEXP from the list of packages that would otherwise be included. Can be specified multiple times; the values will be combined together. Default is to exclude no packages."
    }
    "--critical" = {
      value = "$check_apt_critical$"
      description = "If the full package information of any of the upgradable packages match this REGEXP, the plugin will return CRITICAL status. Can be specified multiple times like above. Default is a regexp matching security upgrades for Debian and Ubuntu: ^[^\\(]*\\(.* (Debian-Security:|Ubuntu:[^/]*/[^-]*-security) Note that the package must first match the include list before its information is compared against the critical list."
    }
    "--only-critical" = {
      set_if = "$check_apt_only_critical$"
      description = "Only warn about upgrades matching the critical list. The total number of upgrades will be printed, but any non-critical upgrades will not cause the plugin to return WARNING status."
    }
    "--input-file" = {
      value = "$check_apt_input_file$"
    }
    "--packages-warning" = {
      value = "$check_apt_packages_warning$"
      description = "Minumum number of packages available for upgrade to return WARNING status. Default is 1 package."
    }
  }
}

