object CheckCommand "check_load" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_load" ]

  arguments = {
    "--warning" = {
      value = "$check_load_warning$"
      description = "Exit with WARNING status if load average exceeds WLOADn"
    }
    "--critical" = {
      value = "$check_load_critical$"
      description = "Exit with CRITICAL status if load average exceed CLOADn the load average format is the same used by \"uptime\" and \"w\""
    }
    "--percpu" = {
      set_if = "$check_load_percpu$"
      description = "Divide the load averages by the number of CPUs (when possible)"
    }
    "--procs-to-show" = {
      value = "$check_load_procs_to_show$"
      description = "Number of processes to show when printing the top consuming processes. NUMBER_OF_PROCS=0 disables this feature. Default value is 0"
    }
  }
}

object CheckCommand "check_log" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_log" ]

  arguments = {
    "--filename" = {
      value = "$check_log_filename$"
    }
    "--oldlog" = {
      value = "$check_log_oldlog$"
    }
    "--max_warning" = {
      value = "$check_log_max_warning$"
      description = "If used, determines the maximum matching value to return as warning, when finding more matching lines than this parameter will return as critical. If not used, will consider as default 0 (any matching will consider as critical)"
    }
    "--query" = {
      value = "$check_log_query$"
    }
    "--exitstatus" = {
      value = "$check_log_exitstatus$"
    }
    "-t" = {
      value = "$check_log_t$"
    }
  }
}

object CheckCommand "check_mailq" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_mailq" ]

  arguments = {
    "--verbose" = {
      set_if = "$check_mailq_verbose$"
      description = "= debugging output"
    }
    "--mailserver" = {
      value = {{
        var v = macro("$check_mailq_mailserver$")
        if (v == true) { return "--mailserver" }
        if (v != false && v != "") { return "--mailserver=" + v }
      }}
      skip_key = true
      set_if = {{
        var v = macro("$check_mailq_mailserver$")
        return v != false && v != "" && v != null
      }}
      description = "= [ sendmail | qmail | postfix | exim | nullmailer | opensmtpd ] (default = autodetect)"
    }
    "--warning" = {
      value = "$check_mailq_warning$"
      description = "= Min. number of messages in queue to generate warning"
    }
    "--critical" = {
      value = "$check_mailq_critical$"
      description = "= Min. number of messages in queue to generate critical alert ( w < c )"
    }
    "--timeout" = {
      value = "$check_mailq_timeout$"
      description = "= Plugin timeout in seconds (default = 15)"
    }
    "--sudo" = {
      set_if = "$check_mailq_sudo$"
    }
    "--configdir" = {
      value = {{
        var v = macro("$check_mailq_configdir$")
        if (v == true) { return "--configdir" }
        if (v != false && v != "") { return "--configdir=" + v }
      }}
      skip_key = true
      set_if = {{
        var v = macro("$check_mailq_configdir$")
        return v != false && v != "" && v != null
      }}
    }
  }
}

object CheckCommand "check_mrtg" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_mrtg" ]

  arguments = {
    "--logfile" = {
      value = "$check_mrtg_logfile$"
      description = "The MRTG log file containing the data you want to monitor"
    }
    "--expires" = {
      value = "$check_mrtg_expires$"
      description = "Minutes before MRTG data is considered to be too old"
    }
    "--aggregation" = {
      value = "$check_mrtg_aggregation$"
      description = "Should we check average or maximum values?"
    }
    "--variable" = {
      value = "$check_mrtg_variable$"
      description = "Which variable set should we inspect? (1 or 2)"
    }
    "--critical" = {
      value = "$check_mrtg_critical$"
      description = "Threshold value for data to result in CRITICAL status"
    }
    "--warning" = {
      value = "$check_mrtg_warning$"
      description = "Threshold value for data to result in WARNING status"
    }
    "--label" = {
      value = "$check_mrtg_label$"
      description = "Type label for data (Examples: Conns, \"Processor Load\", In, Out)"
    }
    "--units" = {
      value = "$check_mrtg_units$"
      description = "Option units label for data (Example: Packets/Sec, Errors/Sec, \"Bytes Per Second\", \"%% Utilization\")"
    }
  }
}

object CheckCommand "check_mrtgtraf" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_mrtgtraf" ]

  arguments = {
    "--filename" = {
      value = "$check_mrtgtraf_filename$"
      description = "File to read log from"
    }
    "--expires" = {
      value = "$check_mrtgtraf_expires$"
      description = "Minutes after which log expires"
    }
    "--aggregation" = {
      value = "$check_mrtgtraf_aggregation$"
      description = "Test average or maximum"
    }
    "--critical" = {
      value = "$check_mrtgtraf_critical$"
      description = "Critical threshold pair <incoming>,<outgoing>"
    }
    "--warning" = {
      value = "$check_mrtgtraf_warning$"
      description = "Warning threshold pair <incoming>,<outgoing>"
    }
    "--verbose" = {
      set_if = "$check_mrtgtraf_verbose$"
      description = "Verbose output during plugin runtime"
    }
    "--interface-maximum" = {
      value = "$check_mrtgtraf_interface_maximum$"
      description = "Define the maximum bandwidth on the port being monitored (Bytes/sec) This adds percentages to performance data output"
    }
  }
}

