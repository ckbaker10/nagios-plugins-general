      set_if = "$check_ntp_peer_use_ipv6$"
      description = "Use IPv6 connection"
    }
    "--quiet" = {
      set_if = "$check_ntp_peer_quiet$"
      description = "Returns UNKNOWN instead of CRITICAL or WARNING if server isn't synchronized"
    }
    "--warning" = {
      value = "$check_ntp_peer_warning$"
      description = "Offset to result in warning status (seconds)"
    }
    "--critical" = {
      value = "$check_ntp_peer_critical$"
      description = "Offset to result in critical status (seconds)"
    }
    "--swarn" = {
      value = "$check_ntp_peer_swarn$"
      description = "Warning threshold for stratum of server's synchronization peer"
    }
    "--scrit" = {
      value = "$check_ntp_peer_scrit$"
      description = "Critical threshold for stratum of server's synchronization peer"
    }
    "--jwarn" = {
      value = "$check_ntp_peer_jwarn$"
      description = "Warning threshold for jitter"
    }
    "--jcrit" = {
      value = "$check_ntp_peer_jcrit$"
      description = "Critical threshold for jitter"
    }
    "--twarn" = {
      value = "$check_ntp_peer_twarn$"
      description = "Warning threshold for number of usable time sources (\"truechimers\")"
    }
    "--tcrit" = {
      value = "$check_ntp_peer_tcrit$"
      description = "Critical threshold for number of usable time sources (\"truechimers\")"
    }
    "--timeout" = {
      value = "$check_ntp_peer_timeout$"
      description = "state> Seconds before connection times out (default: 10) Optional \":<timeout state>\" can be a state integer (0,1,2,3) or a state STRING"
    }
    "--hostname" = {
      value = "$check_ntp_peer_hostname$"
      description = "Host name, IP Address, or unix socket (must be an absolute path)"
    }
    "--port" = {
      value = "$check_ntp_peer_port$"
      description = "Port number (default: 123)"
    }
  }

  vars.check_ntp_peer_hostname = "$address$"
}

object CheckCommand "check_ntp_time" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_ntp_time" ]

  arguments = {
    "--verbose" = {
      set_if = "$check_ntp_time_verbose$"
      description = "Show details for command-line debugging (Nagios may truncate output)"
    }
    "--use-ipv4" = {
      set_if = "$check_ntp_time_use_ipv4$"
      description = "Use IPv4 connection"
    }
    "--use-ipv6" = {
      set_if = "$check_ntp_time_use_ipv6$"
      description = "Use IPv6 connection"
    }
    "--quiet" = {
      set_if = "$check_ntp_time_quiet$"
      description = "Returns UNKNOWN instead of CRITICAL if offset cannot be found"
    }
    "--time-offset" = {
      value = {{
        var v = macro("$check_ntp_time_time_offset$")
        if (v == true) { return "--time-offset" }
        if (v != false && v != "") { return "--time-offset=" + v }
      }}
      skip_key = true
      set_if = {{
        var v = macro("$check_ntp_time_time_offset$")
        return v != false && v != "" && v != null
      }}
      description = "is useful for compensating for servers with known"
    }
    "--delay" = {
      value = {{
        var v = macro("$check_ntp_time_delay$")
        if (v == true) { return "--delay" }
        if (v != false && v != "") { return "--delay=" + v }
      }}
      skip_key = true
      set_if = {{
        var v = macro("$check_ntp_time_delay$")
        return v != false && v != "" && v != null
      }}
      description = "Delay between each packet (seconds)"
    }
    "--warning" = {
      value = "$check_ntp_time_warning$"
      description = "Offset to result in warning status (seconds)"
    }
    "--critical" = {
      value = "$check_ntp_time_critical$"
      description = "Offset to result in critical status (seconds)"
    }
    "--stratum-warn" = {
      value = "$check_ntp_time_stratum_warn$"
      description = "Alert warning if stratum is worse (less) than specfied value"
    }
    "--stratum-crit" = {
      value = "$check_ntp_time_stratum_crit$"
      description = "Alert critical if stratum is worse (less) than specfied value"
    }
    "--timeout" = {
      value = "$check_ntp_time_timeout$"
      description = "state> Seconds before connection times out (default: 10) Optional \":<timeout state>\" can be a state integer (0,1,2,3) or a state STRING"
    }
    "--hostname" = {
      value = "$check_ntp_time_hostname$"
      description = "Host name, IP Address, or unix socket (must be an absolute path)"
    }
    "--port" = {
      value = "$check_ntp_time_port$"
      description = "Port number (default: 123)"
    }
  }

  vars.check_ntp_time_hostname = "$address$"
}

object CheckCommand "check_nwstat" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_nwstat" ]

