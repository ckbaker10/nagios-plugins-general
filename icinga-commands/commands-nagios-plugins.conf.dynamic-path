      description = "name or IP Address of host to ping (IP Address bypasses name lookup, reducing system load)"
    }
    "--sourceip" = {
      value = "$check_fping_sourceip$"
      description = "name or IP Address of sourceip"
    }
    "--sourceif" = {
      value = "$check_fping_sourceif$"
      description = "source interface name"
    }
    "--critical" = {
      value = "$check_fping_critical$"
      description = "critical threshold pair"
    }
    "--warning" = {
      value = "$check_fping_warning$"
      description = "warning threshold pair"
    }
    "--bytes" = {
      value = "$check_fping_bytes$"
      description = "size of ICMP packet (default: 56)"
    }
    "--number" = {
      value = "$check_fping_number$"
      description = "number of ICMP packets to send (default: 1)"
    }
    "--target-timeout" = {
      value = "$check_fping_target_timeout$"
      description = "Target timeout (ms) (default: fping's default for -t)"
    }
    "--interval" = {
      value = "$check_fping_interval$"
      description = "Interval (ms) between sending packets (default: fping's default for -p)"
    }
    "--verbose" = {
      set_if = "$check_fping_verbose$"
      description = "Show details for command-line debugging (Nagios may truncate output)"
    }
    "--use-ipv4" = {
      set_if = "$check_fping_use_ipv4$"
      description = "Use IPv4 connection"
    }
    "--use-ipv6" = {
      set_if = "$check_fping_use_ipv6$"
      description = "Use IPv6 connection"
    }
  }

  vars.check_fping_hostname = "$address$"
}

object CheckCommand "check_hpjd" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_hpjd" ]

  arguments = {
