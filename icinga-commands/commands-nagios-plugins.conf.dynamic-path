      set_if = "$check_nagios_verbose$"
      description = "Show details for command-line debugging (Nagios may truncate output)"
    }
  }
}

object CheckCommand "check_nt" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_nt" ]

  arguments = {
    "--port" = {
      value = "$check_nt_port$"
      description = "Optional port number (default: 1248)"
    }
    "--timeout" = {
      value = "$check_nt_timeout$"
      description = "Seconds before connection attempt times out (default: -l, --params=<parameters> Parameters passed to specified check (see below) -d, --display={SHOWALL} Display options (currently only SHOWALL works) -u, --unknown-timeout (DEPRECATED) Return UNKNOWN on timeouts10)"
    }
    "--critical" = {
      value = "$check_nt_critical$"
      description = "Threshold which will result in a critical status"
    }
    "--warning" = {
      value = "$check_nt_warning$"
      description = "Threshold which will result in a warning status"
    }
    "--variable" = {
      value = "$check_nt_variable$"
      description = "Variable to check"
    }
    "--hostname" = {
      value = "$check_nt_hostname$"
      description = "Name of the host to check"
    }
    "--params" = {
      value = "$check_nt_params$"
      description = "range>,<warning threshold>,<critical threshold>."
    }
    "--secret" = {
      value = "$check_nt_secret$"
      description = "Password needed for the request"
    }
    "--display" = {
      value = "$check_nt_display$"
    }
    "--unknown-timeout" = {
      set_if = "$check_nt_unknown_timeout$"
    }
  }

  vars.check_nt_hostname = "$address$"
}

object CheckCommand "check_ntp" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_ntp" ]

  arguments = {
    "--verbose" = {
      set_if = "$check_ntp_verbose$"
      description = "Show details for command-line debugging (Nagios may truncate output)"
    }
    "--use-ipv4" = {
      set_if = "$check_ntp_use_ipv4$"
      description = "Use IPv4 connection"
    }
    "--use-ipv6" = {
      set_if = "$check_ntp_use_ipv6$"
      description = "Use IPv6 connection"
    }
    "--delay" = {
      value = {{
        var v = macro("$check_ntp_delay$")
        if (v == true) { return "--delay" }
        if (v != false && v != "") { return "--delay=" + v }
      }}
      skip_key = true
      set_if = {{
        var v = macro("$check_ntp_delay$")
        return v != false && v != "" && v != null
      }}
      description = "Delay between each packet (seconds)"
    }
    "--warning" = {
      value = "$check_ntp_warning$"
      description = "Offset to result in warning status (seconds)"
    }
    "--critical" = {
      value = "$check_ntp_critical$"
      description = "Offset to result in critical status (seconds)"
    }
    "--jwarn" = {
      value = "$check_ntp_jwarn$"
      description = "Warning threshold for jitter"
    }
    "--jcrit" = {
      value = "$check_ntp_jcrit$"
      description = "Critical threshold for jitter"
    }
    "--timeout" = {
      value = "$check_ntp_timeout$"
      description = "state> Seconds before connection times out (default: 10) Optional \":<timeout state>\" can be a state integer (0,1,2,3) or a state STRING"
    }
    "--hostname" = {
      value = "$check_ntp_hostname$"
      description = "Host name, IP Address, or unix socket (must be an absolute path)"
    }
    "--allow-zero-stratum" = {
      set_if = "$check_ntp_allow_zero_stratum$"
      description = "Do not discard DNS servers which report a stratum of zero (0)"
    }
  }

  vars.check_ntp_hostname = "$address$"
}

object CheckCommand "check_ntp_peer" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_ntp_peer" ]

  arguments = {
    "--verbose" = {
      set_if = "$check_ntp_peer_verbose$"
