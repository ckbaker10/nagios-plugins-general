object CheckCommand "check_time" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_time" ]

  arguments = {
    "--hostname" = {
      value = "$check_time_hostname$"
      description = "Host name, IP Address, or unix socket (must be an absolute path)"
    }
    "--warning-variance" = {
      value = "$check_time_warning_variance$"
      description = "Time difference (sec.) necessary to result in a warning status"
    }
    "--critical-variance" = {
      value = "$check_time_critical_variance$"
      description = "Time difference (sec.) necessary to result in a critical status"
    }
    "--warning-connect" = {
      value = "$check_time_warning_connect$"
      description = "Response time (sec.) necessary to result in warning status"
    }
    "--critical-connect" = {
      value = "$check_time_critical_connect$"
      description = "Response time (sec.) necessary to result in critical status"
    }
    "--port" = {
      value = "$check_time_port$"
      description = "Port number (default: 37)"
    }
    "--udp" = {
      set_if = "$check_time_udp$"
      description = "Use UDP to connect, not TCP"
    }
    "--timeout" = {
      value = "$check_time_timeout$"
      description = "state> Seconds before connection times out (default: 10) Optional \":<timeout state>\" can be a state integer (0,1,2,3) or a state STRING"
    }
  }

  vars.check_time_hostname = "$address$"
}

object CheckCommand "check_ups" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_ups" ]

  arguments = {
    "--hostname" = {
      value = "$check_ups_hostname$"
      description = "Host name, IP Address, or unix socket (must be an absolute path)"
    }
    "--ups" = {
      value = "$check_ups_ups$"
      description = "Name of UPS"
    }
    "--port" = {
      value = "$check_ups_port$"
      description = "Port number (default: 3493)"
    }
    "--critical" = {
      value = "$check_ups_critical$"
      description = "Response time to result in critical status (seconds)"
    }
    "--warning" = {
      value = "$check_ups_warning$"
      description = "Response time to result in warning status (seconds)"
    }
    "--extended-units" = {
      set_if = "$check_ups_extended_units$"
      description = "Allow nonstandard units in performance data (used for voltage and temperatures)"
    }
    "--timeout" = {
      value = "$check_ups_timeout$"
      description = "state> Seconds before connection times out (default: 10) Optional \":<timeout state>\" can be a state integer (0,1,2,3) or a state STRING"
    }
    "--temperature" = {
      set_if = "$check_ups_temperature$"
      description = "Output of temperatures in Celsius"
    }
    "--variable" = {
      value = "$check_ups_variable$"
      description = "Valid values for STRING are LINE, TEMP, BATTLEFT, BATTPCT or LOADPCT"
    }
  }

  vars.check_ups_hostname = "$address$"
}

