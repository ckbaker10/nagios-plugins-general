object CheckCommand "check_smtp" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_smtp" ]

  arguments = {
    "--hostname" = {
      value = "$check_smtp_hostname$"
      description = "Host name, IP Address, or unix socket (must be an absolute path)"
    }
    "--expect" = {
      value = "$check_smtp_expect$"
      description = "String to expect in first line of server response (default: '220')"
    }
    "--critical" = {
      value = "$check_smtp_critical$"
      description = "Response time to result in critical status (seconds)"
    }
    "--warning" = {
      value = "$check_smtp_warning$"
      description = "Response time to result in warning status (seconds)"
    }
    "--timeout" = {
      value = "$check_smtp_timeout$"
      description = "state> Seconds before connection times out (default: 10) Optional \":<timeout state>\" can be a state integer (0,1,2,3) or a state STRING"
    }
    "--port" = {
      value = "$check_smtp_port$"
      description = "Port number (default: 25)"
    }
    "--from" = {
      value = "$check_smtp_from$"
      description = "FROM-address to include in MAIL command, required by Exchange 2000"
    }
    "--fqdn" = {
      value = "$check_smtp_fqdn$"
      description = "FQDN used for HELO"
    }
    "--authtype" = {
      value = "$check_smtp_authtype$"
      description = "SMTP AUTH type to check (default none, only LOGIN supported)"
    }
    "--authuser" = {
      value = "$check_smtp_authuser$"
      description = "SMTP AUTH username"
    }
    "--authpass" = {
      value = "$check_smtp_authpass$"
      description = "SMTP AUTH password"
    }
    "--command" = {
      value = "$check_smtp_command$"
      description = "SMTP command (may be used repeatedly)"
    }
    "--response" = {
      value = "$check_smtp_response$"
      description = "Expected response to command (may be used repeatedly)"
    }
    "--verbose" = {
      set_if = "$check_smtp_verbose$"
      description = "Show details for command-line debugging (Nagios may truncate output)"
    }
    "--use-ipv4" = {
      set_if = "$check_smtp_use_ipv4$"
      description = "Use IPv4 connection"
    }
    "--use-ipv6" = {
      set_if = "$check_smtp_use_ipv6$"
      description = "Use IPv6 connection"
    }
    "--lmtp" = {
      set_if = "$check_smtp_lmtp$"
      description = "Send LHLO instead of HELO/EHLO"
    }
    "--ssl" = {
      set_if = "$check_smtp_ssl$"
      description = "Use SSL/TLS for the connection."
    }
    "--starttls" = {
      set_if = "$check_smtp_starttls$"
      description = "Use STARTTLS for the connection."
    }
    "--sni" = {
      set_if = "$check_smtp_sni$"
      description = "Enable SSL/TLS hostname extension support (SNI)"
    }
    "--certificate" = {
      value = "$check_smtp_certificate$"
      description = "Minimum number of days a certificate has to be valid."
    }
    "--ignore-quit-failure" = {
      set_if = "$check_smtp_ignore_quit_failure$"
      description = "Ignore failure when sending QUIT command to server"
    }
    "--proxy" = {
      set_if = "$check_smtp_proxy$"
      description = "Use PROXY protocol prefix for the connection."
    }
  }

  vars.check_smtp_hostname = "$address$"
}

object CheckCommand "check_snmp" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_snmp" ]

  arguments = {
    "--verbose" = {
      set_if = "$check_snmp_verbose$"
      description = "Show details for command-line debugging (Nagios may truncate output)"
    }
    "--timeout" = {
      value = "$check_snmp_timeout$"
      description = "state> Seconds before connection times out (default: 10) Optional \":<timeout state>\" can be a state integer (0,1,2,3) or a state STRING"
    }
    "--critical" = {
      value = "$check_snmp_critical$"
      description = "Critical threshold range(s)"
    }
    "--warning" = {
      value = "$check_snmp_warning$"
      description = "Warning threshold range(s)"
    }
    "--hostname" = {
      value = "$check_snmp_hostname$"
      description = "Host name, IP Address, or unix socket (must be an absolute path)"
    }
    "--community" = {
      value = "$check_snmp_community$"
      description = "Optional community string for SNMP communication (default is \"public\")"
    }
    "--oid" = {
      value = "$check_snmp_oid$"
      description = "Object identifier(s) or SNMP variables whose value you wish to query"
    }
    "--object" = {
      value = "$check_snmp_object$"
      description = "Object identifier(s) or SNMP variables whose value you wish to query"
    }
    "--delimiter" = {
      value = "$check_snmp_delimiter$"
      description = "Delimiter to use when parsing returned data. Default is \"=\" Any data on the right hand side of the delimiter is considered to be the data that should be used in the evaluation."
    }
    "--output-delimiter" = {
      value = "$check_snmp_output_delimiter$"
      description = "Separates output on multiple OID requests"
    }
    "--string" = {
      value = "$check_snmp_string$"
      description = "Return OK state (for that OID) if STRING is an exact match"
    }
    "--regex" = {
      value = "$check_snmp_regex$"
      description = "Return OK state (for that OID) if extended regular expression REGEX matches"
    }
    "--ereg" = {
      value = "$check_snmp_ereg$"
      description = "Return OK state (for that OID) if extended regular expression REGEX matches"
    }
    "--eregi" = {
      value = "$check_snmp_eregi$"
      description = "Return OK state (for that OID) if case-insensitive extended REGEX matches"
    }
    "--label" = {
      value = "$check_snmp_label$"
      description = "Prefix label for output from plugin"
    }
    "--units" = {
      value = "$check_snmp_units$"
      description = "Units label(s) for output data (e.g., 'sec.')."
    }
    "--port" = {
      value = "$check_snmp_port$"
      description = "Port number (default: 161)"
    }
    "--retries" = {
      value = "$check_snmp_retries$"
      description = "Number of retries to be used in the requests"
    }
    "--miblist" = {
      value = "$check_snmp_miblist$"
      description = "List of MIBS to be loaded (default = none if using numeric OIDs or 'ALL' for symbolic OIDs.)"
    }
    "--protocol" = {
      value = "$check_snmp_protocol$"
      description = "SNMP protocol version"
    }
    "--context" = {
      value = "$check_snmp_context$"
      description = "SNMPv3 context"
    }
    "--seclevel" = {
      value = "$check_snmp_seclevel$"
      description = "SNMPv3 securityLevel"
    }
    "--secname" = {
      value = "$check_snmp_secname$"
      description = "SNMPv3 username"
    }
    "--authproto" = {
      value = "$check_snmp_authproto$"
      description = "SNMPv3 auth proto"
    }
    "--privproto" = {
      value = "$check_snmp_privproto$"
      description = "SNMPv3 priv proto (default DES)"
    }
    "--authpasswd" = {
      value = "$check_snmp_authpasswd$"
      description = "SNMPv3 authentication password"
    }
    "--privpasswd" = {
      value = "$check_snmp_privpasswd$"
      description = "SNMPv3 privacy password"
    }
    "--next" = {
      set_if = "$check_snmp_next$"
      description = "Use SNMP GETNEXT instead of SNMP GET"
    }
    "--strict" = {
      set_if = "$check_snmp_strict$"
      description = "Enable strict mode: arguments to -o will be checked against the OID returned by snmpget. If they don't match, the plugin returns UNKNOWN."
    }
    "--rate" = {
      set_if = "$check_snmp_rate$"
      description = "Enable rate calculation. See 'Rate Calculation' below"
    }
    "--rate-multiplier" = {
      value = "$check_snmp_rate_multiplier$"
      description = "Converts rate per second. For example, set to 60 to convert to per minute"
    }
    "--offset" = {
      value = "$check_snmp_offset$"
      description = "Add/subtract the specified OFFSET to numeric sensor data"
    }
    "--multiplier" = {
      value = "$check_snmp_multiplier$"
      description = "Multiply the numeric sensor data by MULTIPLIER before doing comparisons"
    }
    "--invert-search" = {
      set_if = "$check_snmp_invert_search$"
      description = "Invert search result (CRITICAL if found)"
    }
    "--perf-oids" = {
      set_if = "$check_snmp_perf_oids$"
      description = "Label performance data with OIDs instead of --label's"
    }
    "--ipv4" = {
      set_if = "$check_snmp_ipv4$"
      description = "Use IPv4 connection"
    }
    "--ipv6" = {
      set_if = "$check_snmp_ipv6$"
      description = "Use IPv6 connection"
    }
    "-E" = {
      value = "$check_snmp_E$"
    }
  }

  vars.check_snmp_hostname = "$address$"
}

