object CheckCommand "check_dig" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_dig" ]

  arguments = {
    "--hostname" = {
      value = "$check_dig_hostname$"
      description = "Host name, IP Address, or unix socket (must be an absolute path)"
    }
    "--query_address" = {
      value = "$check_dig_query_address$"
      description = "Machine name to lookup"
    }
    "--warning" = {
      value = "$check_dig_warning$"
      description = "Response time to result in warning status (seconds)"
    }
    "--critical" = {
      value = "$check_dig_critical$"
      description = "Response time to result in critical status (seconds)"
    }
    "--timeout" = {
      value = "$check_dig_timeout$"
      description = "state> Seconds before connection times out (default: 10) Optional \":<timeout state>\" can be a state integer (0,1,2,3) or a state STRING"
    }
    "--retries" = {
      value = "$check_dig_retries$"
      description = "Number of retries passed to dig, timeout is divided by this value (Default: 3)"
    }
    "--dig-arguments" = {
      value = "$check_dig_dig_arguments$"
      description = "Pass STRING as argument(s) to dig"
    }
    "--verbose" = {
      set_if = "$check_dig_verbose$"
      description = "Show details for command-line debugging (Nagios may truncate output)"
    }
    "--exact" = {
      set_if = "$check_dig_exact$"
      description = "Match records exactly. If not set, fuzzy matches."
    }
    "--record_type" = {
      value = "$check_dig_record_type$"
      description = "Record type to lookup (default: A)"
    }
    "--expected_address" = {
      value = "$check_dig_expected_address$"
      description = "An address expected to be in the answer section. If not set, uses whatever was in -l"
    }
    "--port" = {
      value = "$check_dig_port$"
      description = "Port number (default: 53)"
    }
    "--use-ipv4" = {
      set_if = "$check_dig_use_ipv4$"
      description = "Force dig to only use IPv4 query transport"
    }
    "--use-ipv6" = {
      set_if = "$check_dig_use_ipv6$"
      description = "Force dig to only use IPv6 query transport"
    }
  }

  vars.check_dig_hostname = "$address$"
}

object CheckCommand "check_disk" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_disk" ]

  arguments = {
    "--timeout" = {
      value = "$check_disk_timeout$"
      description = "Seconds before plugin times out (default: 10)"
    }
    "--warning" = {
      value = "$check_disk_warning$"
      order = -1
      description = "Exit with WARNING status if less than INTEGER units of disk are free"
    }
    "--critical" = {
      value = "$check_disk_critical$"
      order = -1
      description = "Exit with CRITICAL status if less than INTEGER units of disk are free"
    }
    "--combined-thresholds" = {
      set_if = "$check_disk_combined_thresholds$"
    }
    "--iwarning" = {
      value = "$check_disk_iwarning$"
      order = -1
      description = "Exit with WARNING status if less than PERCENT of inode space is free"
    }
    "--icritical" = {
      value = "$check_disk_icritical$"
      order = -1
      description = "Exit with CRITICAL status if less than PERCENT of inode space is free"
    }
    "--kilobytes" = {
      set_if = "$check_disk_kilobytes$"
      order = -1
      description = "Same as '--units kB'"
    }
    "--megabytes" = {
      set_if = "$check_disk_megabytes$"
      order = -1
      description = "Same as '--units MB'"
    }
    "--units" = {
      value = "$check_disk_units$"
      order = -1
      description = "Choose bytes, kB, MB, GB, TB, KiB, MiB, GiB, TiB (default: MiB) Note: kB/MB/GB/TB are still calculated as their respective binary units due to backward compatibility issues."
    }
    "--human" = {
      set_if = "$check_disk_human$"
      description = "Produce human-readable output."
    }
    "--path" = {
      value = "$check_disk_path$"
      description = "Mount point or block device as emitted by the mount(8) command (may be repeated)"
    }
    "--partition" = {
      value = "$check_disk_partition$"
      description = "Mount point or block device as emitted by the mount(8) command (may be repeated)"
    }
    "--exclude_device" = {
      value = "$check_disk_exclude_device$"
      description = "Ignore device (only works if -p unspecified)"
    }
    "--exclude-type" = {
      value = "$check_disk_exclude_type$"
      description = "Ignore all filesystems of indicated type (may be repeated)"
    }
    "--include-type" = {
      value = "$check_disk_include_type$"
      description = "Check only filesystems of indicated type (may be repeated)"
    }
    "--newlines" = {
      set_if = "$check_disk_newlines$"
      description = "Multi-line output of each disk's status information on a new line"
    }
    "--group" = {
      value = "$check_disk_group$"
      description = "Group paths. Thresholds apply to (free-)space of all partitions together"
    }
    "--eregi-path" = {
      value = "$check_disk_eregi_path$"
      description = "Case insensitive regular expression for path/partition (may be repeated)"
    }
    "--eregi-partition" = {
      value = "$check_disk_eregi_partition$"
      description = "Case insensitive regular expression for path/partition (may be repeated)"
    }
    "--ereg-path" = {
      value = "$check_disk_ereg_path$"
      description = "Regular expression for path or partition (may be repeated)"
    }
    "--ereg-partition" = {
      value = "$check_disk_ereg_partition$"
      description = "Regular expression for path or partition (may be repeated)"
    }
    "--freespace-ignore-reserved" = {
      set_if = "$check_disk_freespace_ignore_reserved$"
      description = "Don't account root-reserved blocks into freespace in perfdata"
    }
    "--ignore-ereg-path" = {
      value = "$check_disk_ignore_ereg_path$"
      description = "Regular expression to ignore selected path or partition (may be repeated)"
    }
    "--ignore-ereg-partition" = {
      value = "$check_disk_ignore_ereg_partition$"
      description = "Regular expression to ignore selected path or partition (may be repeated)"
    }
    "--ignore-eregi-path" = {
      value = "$check_disk_ignore_eregi_path$"
      description = "Regular expression to ignore selected path/partition (case insensitive) (may be repeated)"
    }
    "--ignore-eregi-partition" = {
      value = "$check_disk_ignore_eregi_partition$"
      description = "Regular expression to ignore selected path/partition (case insensitive) (may be repeated)"
    }
    "--local" = {
      set_if = "$check_disk_local$"
      description = "Only check local filesystems"
    }
    "--skip-fake-fs" = {
      set_if = "$check_disk_skip_fake_fs$"
    }
    "--inode-perfdata" = {
      set_if = "$check_disk_inode_perfdata$"
      description = "Enable performance data for inode-based statistics"
    }
    "--stat-remote-fs" = {
      set_if = "$check_disk_stat_remote_fs$"
      description = "Only check local filesystems against thresholds. Yet call stat on remote filesystems to test if they are accessible (e.g. to detect Stale NFS Handles)"
    }
    "--mountpoint" = {
      set_if = "$check_disk_mountpoint$"
      description = "Display the mountpoint instead of the partition"
    }
    "--errors-only" = {
      set_if = "$check_disk_errors_only$"
      description = "Display only devices/mountpoints with errors"
    }
    "--exact-match" = {
      set_if = "$check_disk_exact_match$"
      description = "For paths or partitions specified with -p, only check for exact paths"
    }
    "--all" = {
      set_if = "$check_disk_all$"
      description = "Explicitly select all paths. This is equivalent to -R '.*'"
    }
    "--verbose" = {
      set_if = "$check_disk_verbose$"
      description = "Show details for command-line debugging (Nagios may truncate output)"
    }
    "--quiet" = {
      set_if = "$check_disk_quiet$"
    }
    "--clear" = {
      set_if = "$check_disk_clear$"
      description = "Clear thresholds"
    }
  }
}

object CheckCommand "check_disk_smb" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_disk_smb" ]

  arguments = {
    "--verbose" = {
      set_if = "$check_disk_smb_verbose$"
    }
    "--port" = {
      value = "$check_disk_smb_port$"
      description = "Port to be used to connect to. Some Windows boxes use 139, others 445 (Defaults to smbclient default)"
    }
    "--kerberos" = {
      set_if = "$check_disk_smb_kerberos$"
    }
    "--maxprotocol" = {
      value = "$check_disk_smb_maxprotocol$"
    }
    "--warning" = {
      value = "$check_disk_smb_warning$"
      description = "or INTEGER[kMG] Percent of used space at which a warning will be generated (Default: 85%)"
    }
    "--critical" = {
      value = "$check_disk_smb_critical$"
      description = "or INTEGER[kMG] Percent of used space at which a critical will be generated (Defaults: 95%)"
    }
    "--password" = {
      value = "$check_disk_smb_password$"
      description = "Password to log in to server. (Defaults to an empty password)"
    }
    "--username" = {
      value = "$check_disk_smb_username$"
      description = "Username to log in to server. (Defaults to \"guest\")"
    }
    "--share" = {
      value = "$check_disk_smb_share$"
      description = "Share name to be tested"
    }
    "--workgroup" = {
      value = "$check_disk_smb_workgroup$"
      description = "Workgroup or Domain used (Defaults to \"WORKGROUP\")"
    }
    "--hostname" = {
      value = "$check_disk_smb_hostname$"
      description = "NetBIOS name of the server"
    }
    "--address" = {
      value = "$check_disk_smb_address$"
      description = "IP-address of HOST (only necessary if HOST is in another network)"
    }
    "--configfile" = {
      value = "$check_disk_smb_configfile$"
      description = "Path to configfile which should be used by smbclient (Defaults to smb.conf of your smb installation)"
    }
  }

  vars.check_disk_smb_hostname = "$address$"
}

object CheckCommand "check_dns" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_dns" ]

  arguments = {
    "--verbose" = {
      set_if = "$check_dns_verbose$"
    }
    "--timeout" = {
      value = "$check_dns_timeout$"
      description = "state> Seconds before connection times out (default: 10) Optional \":<timeout state>\" can be a state integer (0,1,2,3) or a state STRING"
    }
    "--hostname" = {
      value = "$check_dns_hostname$"
      description = "The name or address you want to query"
    }
    "--server" = {
      value = "$check_dns_server$"
      description = "Optional DNS server you want to use for the lookup"
    }
    "--reverse-server" = {
      value = "$check_dns_reverse_server$"
    }
    "--querytype" = {
      value = "$check_dns_querytype$"
      description = "Optional DNS record query type where TYPE =(A, AAAA, SRV, TXT, MX, ANY) The default query type is 'A' (IPv4 host entry) BIND 9.11.x onwards supports both 'A' and 'AAAA', if you want both use 'ANY'"
    }
    "--expected-address" = {
      value = "$check_dns_expected_address$"
      description = "Optional IP-ADDRESS you expect the DNS server to return. HOST must end with a dot (.). This option can be repeated multiple times (Returns OK if any value match). If multiple addresses are returned at once, you have to match the whole string of addresses separated with commas (sorted alphabetically). If you would like to test for the presence of a cname, combine with -n param."
    }
    "--expect-authority" = {
      set_if = "$check_dns_expect_authority$"
      description = "Optionally expect the DNS server to be authoritative for the lookup"
    }
    "--accept-cname" = {
      set_if = "$check_dns_accept_cname$"
      description = "Optionally accept cname responses as a valid result to a query The default is to ignore cname responses as part of the result"
    }
    "--warning" = {
      value = "$check_dns_warning$"
      description = "Return warning if elapsed time exceeds value. Default off"
    }
    "--critical" = {
      value = "$check_dns_critical$"
      description = "Return critical if elapsed time exceeds value. Default off"
    }
  }

  vars.check_dns_hostname = "$address$"
}

object CheckCommand "check_dummy" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_dummy" ]

  arguments = {
    "state" = {
