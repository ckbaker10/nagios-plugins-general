      skip_key = true
      order = 1
      required = true
      description = "Integer state to return (0=OK, 1=WARNING, 2=CRITICAL, 3=UNKNOWN)"
    }
    "text" = {
      value = "$check_dummy_text$"
      skip_key = true
      order = 2
      description = "Optional text to return"
    }
  }
}

