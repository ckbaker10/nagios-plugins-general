object CheckCommand "check_procs" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_procs" ]

  arguments = {
    "--warning" = {
      value = "$check_procs_warning$"
      description = "Generate warning state if metric is outside this range"
    }
    "--critical" = {
      value = "$check_procs_critical$"
      description = "Generate critical state if metric is outside this range"
    }
    "--metric" = {
      value = "$check_procs_metric$"
      description = "Check thresholds against metric. Valid types: PROCS - number of processes (default) VSZ - virtual memory size RSS - resident set memory size CPU - percentage CPU ELAPSED - time elapsed in seconds"
    }
    "--timeout" = {
      value = "$check_procs_timeout$"
      description = "Seconds before plugin times out (default: 10)"
    }
    "--status" = {
      value = "$check_procs_status$"
      description = "Only scan for processes that have, in the output of `ps`, one or more of the status flags you specify (for example R, Z, S, RS, RSZDT, plus others based on the output of your 'ps' command)."
    }
    "--ppid" = {
      value = "$check_procs_ppid$"
      description = "Only scan for children of the parent process ID indicated."
    }
    "--user" = {
      value = "$check_procs_user$"
      description = "Only scan for processes with user name or ID indicated."
    }
    "--command" = {
      value = "$check_procs_command$"
      description = "Only scan for exact matches of COMMAND (without path)."
    }
    "--vsz" = {
      value = "$check_procs_vsz$"
      description = "Only scan for processes with VSZ higher than indicated."
    }
    "--rss" = {
      value = "$check_procs_rss$"
      description = "Only scan for processes with RSS higher than indicated."
    }
    "--pcpu" = {
      value = "$check_procs_pcpu$"
      description = "Only scan for processes with PCPU higher than indicated."
    }
    "--elapsed" = {
      value = "$check_procs_elapsed$"
    }
    "--argument-array" = {
      value = "$check_procs_argument_array$"
      description = "Only scan for processes with args that contain STRING."
    }
    "--verbose" = {
      set_if = "$check_procs_verbose$"
      description = "Extra information. Up to 3 verbosity levels"
    }
    "--ereg-argument-array" = {
      value = "$check_procs_ereg_argument_array$"
      description = "Only scan for processes with args that contain the regex STRING."
    }
    "--input-file" = {
      value = "$check_procs_input_file$"
      description = "Use FILE content instead of /bin/ps output."
    }
    "--no-kthreads" = {
      value = "$check_procs_no_kthreads$"
      description = "Only scan for non kernel threads (works on Linux only)."
    }
    "--traditional-filter" = {
      set_if = "$check_procs_traditional_filter$"
      description = "Filter own process the traditional way by PID instead of /proc/pid/exe"
    }
    "--cgroup-hierarchy" = {
      value = "$check_procs_cgroup_hierarchy$"
      description = "Only scan for processes belonging to STRING hierarchy (works on Linux only)."
    }
    "--exclude-process" = {
      value = "$check_procs_exclude_process$"
      description = "Exclude processes which match this comma separated list"
    }
    "--jid" = {
      value = "$check_procs_jid$"
      description = "Only scan for process running in jail which ID is JID."
    }
  }
}

