object CheckCommand "check_http" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_http" ]

  arguments = {
    "--verbose" = {
      set_if = "$check_http_verbose$"
      description = "Show details for command-line debugging (Nagios may truncate output)"
    }
    "--timeout" = {
      value = "$check_http_timeout$"
      description = "state> Seconds before connection times out (default: 10) Optional \":<timeout state>\" can be a state integer (0,1,2,3) or a state STRING"
    }
    "--critical" = {
      value = "$check_http_critical$"
      description = "Response time to result in critical status (seconds)"
    }
    "--warning" = {
      value = "$check_http_warning$"
      description = "Response time to result in warning status (seconds)"
    }
    "--hostname" = {
      value = "$check_http_vhost$"
      description = "Host name argument for servers using host headers (virtual host) Append a port to include it in the header (eg: example.com:5000)"
    }
    "--link" = {
      set_if = "$check_http_link$"
      description = "Wrap output in HTML link (obsoleted by urlize)"
    }
    "--nohtml" = {
      set_if = "$check_http_nohtml$"
    }
    "--ssl" = {
      value = {{
        var v = macro("$check_http_ssl$")
        if (v == true) { return "--ssl" }
        if (v != false && v != "") { return "--ssl=" + v }
      }}
      skip_key = true
      set_if = {{
        var v = macro("$check_http_ssl$")
        return v != false && v != "" && v != null
      }}
      description = "Connect via SSL. Port defaults to 443. VERSION is optional, and prevents auto-negotiation (2 = SSLv2, 3 = SSLv3, 1 = TLSv1, 1.1 = TLSv1.1, 1.2 = TLSv1.2). With a '+' suffix, newer versions are also accepted."
    }
    "--sni" = {
      set_if = "$check_http_sni$"
      description = "Enable SSL/TLS hostname extension support (SNI)"
    }
    "--verify-host" = {
      set_if = "$check_http_verify_host$"
      description = "Verify SSL certificate is for the -H hostname (with --sni and -S)"
    }
    "--post" = {
      value = "$check_http_post$"
      description = "URL encoded http POST data"
    }
    "--method" = {
      value = "$check_http_method$"
      description = "(for example: HEAD, OPTIONS, TRACE, PUT, DELETE, CONNECT) Set HTTP method."
    }
    "--IP-address" = {
      value = "$check_http_IP_address$"
      description = "IP address or name (use numeric address if possible to bypass DNS lookup)."
    }
    "--url" = {
      value = "$check_http_url$"
      description = "(deprecated) URL to GET or POST (default: /)"
    }
    "--uri" = {
      value = "$check_http_uri$"
      description = "URI to GET or POST (default: /)"
    }
    "--port" = {
      value = "$check_http_port$"
      description = "Port number (default: 80)"
    }
    "--authorization" = {
      value = "$check_http_authorization$"
      description = "Username:password on sites with basic authentication"
    }
    "--proxy-authorization" = {
      value = "$check_http_proxy_authorization$"
      description = "Username:password on proxy-servers with basic authentication"
    }
    "--header-string" = {
      value = "$check_http_header_string$"
      description = "String to expect in the response headers"
    }
    "--string" = {
      value = "$check_http_string$"
      description = "String to expect in the content"
    }
    "--expect" = {
      value = "$check_http_expect$"
      description = "Comma-delimited list of strings, at least one of them is expected in the first (status) line of the server response (default: HTTP/1.) If specified skips all other status line logic (ex: 3xx, 4xx, 5xx processing)"
    }
    "--regex" = {
      value = "$check_http_regex$"
      description = "Search page for regex STRING"
    }
    "--ereg" = {
      value = "$check_http_ereg$"
      description = "Search page for regex STRING"
    }
    "--eregi" = {
      value = "$check_http_eregi$"
      description = "Search page for case-insensitive regex STRING"
    }
    "--linespan" = {
      set_if = "$check_http_linespan$"
      description = "Allow regex to span newlines (must precede -r or -R)"
    }
    "--onredirect" = {
      value = "$check_http_onredirect$"
      description = "How to handle redirected pages. sticky is like follow but stick to the specified IP address. stickyport also ensures port stays the same."
    }
    "--certificate" = {
      value = "$check_http_certificate$"
      description = "Minimum number of days a certificate has to be valid. Port defaults to 443 (When this option is used the URL is not checked by default. You can use"
    }
    "--continue-after-certificate" = {
      set_if = "$check_http_continue_after_certificate$"
      description = "to override this behavior)"
    }
    "--client-cert" = {
      value = "$check_http_client_cert$"
      description = "Name of file that contains the client certificate (PEM format) to be used in establishing the SSL session"
    }
    "--private-key" = {
      value = "$check_http_private_key$"
      description = "Name of file containing the private key (PEM format) matching the client certificate"
    }
    "--useragent" = {
      value = "$check_http_useragent$"
      description = "String to be sent in http header as \"User Agent\""
    }
    "--header" = {
      value = "$check_http_header$"
      description = "Any other tags to be sent in http header. Use multiple times for additional headers"
    }
    "--no-body" = {
      set_if = "$check_http_no_body$"
      description = "Don't wait for document body: stop reading after headers. (Note that this still does an HTTP GET or POST, not a HEAD.)"
    }
    "--max-age" = {
      value = "$check_http_max_age$"
      description = "Warn if document is more than SECONDS old. the number can also be of the form \"10m\" for minutes, \"10h\" for hours, or \"10d\" for days."
    }
    "--content-type" = {
      value = "$check_http_content_type$"
      description = "specify Content-Type header media type when POSTing"
    }
    "--pagesize" = {
      value = "$check_http_pagesize$"
      description = "Minimum page size required (bytes) : Maximum page size required (bytes)"
    }
    "--invert-regex" = {
      set_if = "$check_http_invert_regex$"
      description = "Return CRITICAL if found, OK if not"
    }
    "--use-ipv4" = {
      set_if = "$check_http_use_ipv4$"
      description = "Use IPv4 connection"
    }
    "--use-ipv6" = {
      set_if = "$check_http_use_ipv6$"
      description = "Use IPv6 connection"
    }
    "--extended-perfdata" = {
      set_if = "$check_http_extended_perfdata$"
      description = "Print additional performance data"
    }
    "--output-body-as-perfdata" = {
      set_if = "$check_http_output_body_as_perfdata$"
      description = "Output response body as performance data on succes"
    }
    "--show-url" = {
      set_if = "$check_http_show_url$"
      description = "Print URL in msg output in plain text"
    }
  }

  vars.check_http_IP_address = "$address$"
}

object CheckCommand "check_icmp" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_icmp" ]

  arguments = {
    "-v" = {
      set_if = "$check_icmp_verbose$"
      description = "verbose"
    }
    "-w" = {
      value = "$check_icmp_warning$"
      description = "warning threshold (currently 200.000ms,40%)"
    }
    "-c" = {
      value = "$check_icmp_critical$"
      description = "critical threshold (currently 500.000ms,80%)"
    }
    "-n" = {
      value = "$check_icmp_num_packets$"
      description = "number of packets to send (currently 5)"
    }
    "-p" = {
      value = "$check_icmp_packets$"
      description = "number of packets to send (currently 5)"
    }
    "-t" = {
      value = "$check_icmp_timeout$"
      description = "timeout value (seconds, currently 10)"
    }
    "-H" = {
      value = "$check_icmp_host$"
      description = "specify a target"
    }
    "-s" = {
      value = "$check_icmp_source$"
      description = "specify a source IP address or device name"
    }
    "-i" = {
      value = "$check_icmp_packet_interval$"
      description = "max packet interval (currently 80.000ms)"
    }
    "-b" = {
      value = "$check_icmp_data_bytes$"
      description = "Number of icmp data bytes to send Packet size will be data bytes + icmp header (currently 68 + 8)"
    }
    "-f" = {
      value = "$check_icmp_perfdata_separator$"
      description = "separator for perfdata instance"
    }
    "-F" = {
      value = "$check_icmp_perfdata_instances$"
      description = "number of instances to output perfdata for"
    }
    "-I" = {
      value = "$check_icmp_target_interval$"
      description = "max target interval (currently 0.000ms)"
    }
    "-l" = {
      value = "$check_icmp_ttl$"
      description = "TTL on outgoing packets (currently 0)"
    }
    "-m" = {
      value = "$check_icmp_min_hosts_alive$"
      description = "number of alive hosts required for success"
    }
    "-P" = {
      value = "$check_icmp_packet_loss_mode$"
      description = "packet loss mode, ex. 40%,50% , unit in %"
    }
    "-R" = {
      value = "$check_icmp_rta_mode$"
      description = "RTA, round trip average, mode warning,critical, ex. 100ms,200ms unit in ms"
    }
    "-J" = {
      value = "$check_icmp_jitter_mode$"
      description = "jitter mode warning,critical, ex. 40.000ms,50.000ms , unit in ms"
    }
    "-S" = {
      value = "$check_icmp_score_mode$"
      description = "score mode, max value 100 warning,critical, ex. 80,70"
    }
    "-M" = {
      value = "$check_icmp_mos_mode$"
      description = "MOS mode, between 0 and 4.4 warning,critical, ex. 3.5,3.0"
    }
    "-O" = {
      value = "1"
      set_if = "$check_icmp_out_of_order$"
      description = "detect out of order ICMP packts"
    }
    "-6" = {
      set_if = "$check_icmp_ipv6$"
      description = "target address(es) are IPv6 and packets are ICMPv6"
    }
    "-4" = {
      set_if = "$check_icmp_ipv4$"
      description = "target address(es) are IPv4 and packets are ICMPv4"
    }
  }

  vars.check_icmp_host = "$address$"
}

object CheckCommand "check_ide_smart" {
  import "plugin-check-command"
  command = [ PluginDir + "/check_ide_smart" ]

  arguments = {
    "--device" = {
      value = "$check_ide_smart_device$"
      description = "Select device DEVICE Note: if the device is selected with this option, _no_ other options are accepted"
    }
    "--immediate" = {
      set_if = "$check_ide_smart_immediate$"
      description = "Perform immediately offline tests"
